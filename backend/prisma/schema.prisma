// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  assignedTasks  Task[]  @relation("AssignedTo")
  createdTasks   Task[]  @relation("AssignedBy")
  attendace      Attendance[]

  @@map("users")
}

model Ship {
  id            Int     @id @default(autoincrement())
  shipName      String  @map("ship_name")
  shipModel     String  @map("ship_model")
  shipCapacity  Int  @map("ship_capacity")

  tasks Task[]
  drills Drill[]
  shipDetails ShipDetails[]

  @@map("ships")
}

model ShipDetails {
    id               Int     @id @default(autoincrement())

    ship             Ship    @relation(fields: [shipId], references:[id])
    shipId           Int     @map("ship_id")

    shipSource       String  @map("ship_source")
    shipDestination  String  @map("ship_destination")

    departureDate    DateTime
    arrivalDate      DateTime

    @@map("ship_details")
}

model Task {
  id             Int        @id @default(autoincrement())
  taskName       String     @map("task_name")
  taskDescription String    @map("task_description")
  status         TaskStatus
  commentByCrew  String?    @map("comment_by_crew")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  assignedShip   Ship    @relation(fields: [assignedShipId], references: [id])
  assignedShipId Int     @map("assigned_ship")

  assignedBy     User    @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedById   Int     @map("assigned_by")

  assignedTo     User    @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId   Int     @map("assigned_to")

  dueDate        DateTime

  @@map("tasks")
}

model Drill {
  id        Int      @id @default(autoincrement())
  drillName String   @map("drill_name")
  drillType String
  drillDate DateTime @map("drill_date")
  location  String
  createdAt DateTime @default(now()) @map("created_at")

  ship   Ship @relation(fields: [shipId], references: [id])
  shipId Int  @map("ship_id")

  attendance Attendance[]

  @@map("drills")
}

model Attendance {
  id       Int              @id @default(autoincrement())
  status   AttendanceStatus
  markedOn DateTime         @default(now()) @map("marked_on")

  drill   Drill @relation(fields: [drillId], references: [id])
  drillId Int   @map("drill_id")

  crew   User @relation(fields: [crewId], references: [id])
  crewId Int  @map("crew_id")

  @@unique([drillId, crewId]) // prevent duplicate attendance per drill
  @@map("attendance")
}